@page
@model wooden_heritage2.Pages.GalleryModel
@{
    ViewData["Title"] = "Gallery";
}

<section>
    <h1>Gallery</h1>
    <p>Take a look at our beautiful cabin and surroundings</p>

    <div class="carousel-container">

        <div class="carousel">

            <div class="carousel-slide active">
                <figure>
                    <img src="~/images/front-view.png" alt="Front view of cabin" class="carousel-image">
                    <figcaption>Front View (AI Generated via Microsoft Copilot, 2026)</figcaption>
                </figure>
            </div>

            <div class="carousel-slide">
                <figure>
                    <img src="~/images/bedroom1.png" alt="Master suite" class="carousel-image">
                    <figcaption>Suite Room (AI Generated via Microsoft Copilot, 2026)</figcaption>
                </figure>
            </div>

            <div class="carousel-slide">
                <figure>
                    <img src="~/images/bedroom2.png" alt="Bedroom 2" class="carousel-image">
                    <figcaption>Bedroom 2 (AI Generated via Microsoft Copilot, 2026)</figcaption>
                </figure>
            </div>

            <div class="carousel-slide">
                <figure>
                    <img src="~/images/bedroom3.png" alt="Bedroom 3" class="carousel-image">
                    <figcaption>Bedroom 3 (AI Generated via Microsoft Copilot, 2026)</figcaption>
                </figure>
            </div>

            <div class="carousel-slide">
                <figure>
                    <img src="~/images/bathroom.png" alt="Bathroom" class="carousel-image">
                    <figcaption>Bathroom (AI Generated via Microsoft Copilot, 2026)</figcaption>
                </figure>
            </div>

            <div class="carousel-slide">
                <figure>
                    <img src="~/images/living-lounge.png" alt="Living lounge" class="carousel-image">
                    <figcaption>Living Lounge (AI Generated via Microsoft Copilot, 2026)</figcaption>
                </figure>
            </div>

            <div class="carousel-slide">
                <figure>
                    <img src="~/images/kitchen.png" alt="Kitchen" class="carousel-image">
                    <figcaption>Kitchen (AI Generated via Microsoft Copilot, 2026)</figcaption>
                </figure>
            </div>

            <div class="carousel-slide">
                <figure>
                    <img src="~/images/outdoor-deck.png" alt="Outdoor deck" class="carousel-image">
                    <figcaption>Outdoor Deck (AI Generated via Microsoft Copilot, 2026)</figcaption>
                </figure>
            </div>

        </div>

        <button class="carousel-btn prev" onclick="changeSlide(-1)" aria-label="Previous image">&#10094;</button>
        <button class="carousel-btn next" onclick="changeSlide(1)" aria-label="Next image">&#10095;</button>

        <div class="carousel-dots">
            <span class="dot active" onclick="goToSlide(0)"></span>
            <span class="dot" onclick="goToSlide(1)"></span>
            <span class="dot" onclick="goToSlide(2)"></span>
            <span class="dot" onclick="goToSlide(3)"></span>
            <span class="dot" onclick="goToSlide(4)"></span>
            <span class="dot" onclick="goToSlide(5)"></span>
            <span class="dot" onclick="goToSlide(6)"></span>
            <span class="dot" onclick="goToSlide(7)"></span>
        </div>

    </div>
</section>

@section Scripts {
    <script>
        let current = 0;
        const slides = document.querySelectorAll('.carousel-slide');
        const dots = document.querySelectorAll('.dot');

        function showSlide(i) {
            slides.forEach(s => s.classList.remove('active'));
            dots.forEach(d => d.classList.remove('active'));
            current = (i + slides.length) % slides.length;
            slides[current].classList.add('active');
            dots[current].classList.add('active');
        }

        function changeSlide(dir) {
            showSlide(current + dir);
        }

        function goToSlide(i) {
            showSlide(i);
        }

        setInterval(() => changeSlide(1), 7000);
    </script>
}