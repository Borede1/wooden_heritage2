@page
@model wooden_heritage2.Pages.IndexModel
@{
    ViewData["Title"] = "Home";
}

<section class="hero">
    <h1>Welcome to Wooden Heritage Cabin</h1>
    <p>Experience the charm of wooden heritage cabin where every moment feels timeless</p>
    <figure>
        <img src="~/images/front-view.png"
             alt="Front view of Wooden Heritage Cabin surrounded by nature"
             class="curved">
        <figcaption>Front view of cabin (AI Generated via Microsoft Copilot, 2026)</figcaption>
    </figure>
</section>

<section class="features-section">
    <h2>Our Features</h2>
    <p>Everything you need for the perfect getaway</p>

    <div class="features-grid">

        <div class="feature-card">
            <span class="feature-icon">🔥</span>
            <h3>Cozy Fireplace</h3>
            <p>Warm up by our rustic wood-burning fireplace on cool evenings</p>
        </div>

        <div class="feature-card">
            <span class="feature-icon">🪵</span>
            <h3>Wooden Interior</h3>
            <p>Natural timber walls and floors throughout the entire cabin</p>
        </div>

        <div class="feature-card">
            <span class="feature-icon">🌿</span>
            <h3>Outdoor Deck</h3>
            <p>Spacious deck perfect for stargazing and morning coffee</p>
        </div>

        <div class="feature-card">
            <span class="feature-icon">♨️</span>
            <h3>Private Hot Tub</h3>
            <p>Relax and unwind in your own private hot tub under the stars</p>
        </div>

    </div>
</section>

<section class="book-section">
    <h2>Book Your Stay</h2>
    <p>Ready for an unforgettable experience? Get in touch today</p>
    <a asp-page="/Contact" class="book-button">Contact Us</a>
</section>